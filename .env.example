# Kalshi
KALSHI_API_KEY_ID=your-key-id
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
KALSHI_ENV=demo

# Evaluator LLM (Gemini is default; supports Claude/OpenAI via EVALUATOR_LLM_PROVIDER)
EVALUATOR_LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-gemini-api-key

# Optional: if switching evaluator to Claude or OpenAI
# EVALUATOR_LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# EVALUATOR_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# NWS (optional — for User-Agent header)
NWS_CONTACT_EMAIL=your@email.com
